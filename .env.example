# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# LLM Providers (Provide your actual keys in .env, never commit them)
GEMINI_API_KEY="your-gemini-api-key-here"
GROQ_API_KEY="your-groq-api-key-here"
CEREBRAS_API_KEY=

# Multi-LLM Gateway Routing & Quotas
DEFAULT_PLANNER_PROVIDER=gemini
FALLBACK_PLANNER_PROVIDER=groq
CRITIC_PROVIDER=groq
MAX_REQUESTS_PER_MINUTE=60
DAILY_TOKEN_QUOTA=1000000

# Mode Flags
MOCK_LLM_MODE=false
ENABLE_CIRCUIT_BREAKER=true
ENABLE_CACHE=true
